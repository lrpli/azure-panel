# Optional. You can also input these in the web UI.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
PERSIST_AZURE_CONFIG=true
AZURE_RUNTIME_CONFIG_PATH=./.azure-runtime-config.json
PERSIST_KEYCHAIN=true
KEYCHAIN_PATH=./.keychain.json
PERSIST_TELEGRAM_CONFIG=true
TELEGRAM_RUNTIME_CONFIG_PATH=./.telegram-runtime-config.json
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=false
TELEGRAM_ALLOWED_CHAT_IDS=

# Panel login
PANEL_ADMIN_USERNAME=admin
PANEL_ADMIN_PASSWORD=admin123456
SESSION_TTL_HOURS=8
MAX_JSON_BODY_BYTES=1048576
POWER_STATE_CACHE_TTL_MS=15000

# Audit log output file
AUDIT_LOG_PATH=./audit.log

# Optional app config
HOST=127.0.0.1
PORT=18080
